- id: vana_state_sync
  alias: Vana — Forced RPC Status Sync
  description: 'HA start, MQTT availability up ve her 5dk RPC Switch.GetStatus publish.
    Cihaz state degismese de status_topic refresh tetikler. Unknown penceresini kapatir.

    '
  triggers:
  - trigger: homeassistant
    event: start
  - trigger: time_pattern
    minutes: /5
  - trigger: mqtt
    topic: shelly-mutfak/online
    payload: 'true'
  actions:
  - action: mqtt.publish
    data:
      topic: shelly-mutfak/rpc
      payload: '{"id":99,"src":"shelly-mutfak/ha-sync","method":"Switch.GetStatus","params":{"id":0}}'
      qos: 1
  mode: single
- id: vana_unknown_alert
  alias: Vana — Unknown 5dk asili kalirsa uyari
  description: 'Vana state 5 dakikadan uzun unknown/unavailable kalirsa kullaniciya
    push at. Erken uyari.

    '
  triggers:
  - trigger: state
    entity_id: switch.mutfak_su_vanasi
    to:
    - unknown
    - unavailable
    for: 00:05:00
  actions:
  - action: notify.mobile_app_sm_s901e
    data:
      title: Vana Durumu Bilinmiyor
      message: Mutfak Su Vanasi 5dk+ unknown. Shelly/MQTT baglantisi kontrol et.
      data:
        priority: high
  mode: single
- id: vana_state_relay
  alias: Vana — RPC reply -> state_topic relay
  description: 'Shelly Gen2 RPC GetStatus cevabini ha-sync/rpc topic dinler, result
    objesini status/switch:0 topic uzerinden re-publish eder. MQTT switch state_topic
    boslugunu kapatir.

    '
  triggers:
  - trigger: mqtt
    topic: shelly-mutfak/ha-sync/rpc
  conditions:
  - condition: template
    value_template: '{{ trigger.payload_json.result.output is defined }}'
  actions:
  - action: mqtt.publish
    data:
      topic: shelly-mutfak/status/switch:0
      payload: '{{ {''output'': trigger.payload_json.result.output} | tojson }}'
      qos: 1
  mode: queued
