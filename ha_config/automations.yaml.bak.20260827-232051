- id: '1774792787834'
  alias: Su Arıtma - Çeşme Açıldı (Otomatik Vana)
  description: 'MC-38 manyetik sensör çeşme kolunun açıldığını algılar ve solenoid
    vanayı otomatik açar. Güvenlik kilidi veya sızıntı varsa açmaz.

    '
  triggers:
  - trigger: state
    entity_id: binary_sensor.mutfak_su_akisi
    to: 'on'
  conditions:
  - condition: template
    value_template: '{{ not is_state(''switch.mutfak_su_vanasi'', ''on'') }}'
  - condition: not
    conditions:
    - condition: state
      entity_id: binary_sensor.mutfak_su_sizinti_sensoru_water_leak
      state: 'on'
  - condition: state
    entity_id: input_boolean.mutfakta_su_sizintisi_var
    state: 'off'
  - condition: state
    entity_id: input_boolean.su_aritma_guvenlik_kilidi
    state: 'off'
  actions:
  - choose:
    - conditions:
      - condition: state
        entity_id: switch.mutfak_su_vanasi
        state: unknown
      sequence:
      - action: mqtt.publish
        data:
          topic: shelly-mutfak/rpc
          payload: '{"id":98,"src":"shelly-mutfak/ha-sync","method":"Switch.GetStatus","params":{"id":0}}'
          qos: 1
      - delay: 00:00:02
  - action: switch.turn_on
    target:
      entity_id: switch.mutfak_su_vanasi
  mode: single
